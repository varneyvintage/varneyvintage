# Copy to .env and fill in. NEVER commit .env.
SANKOFA_CONFIG=config/settings.yaml

# --- Execution -------------------------------------------------------------
# paper | alpaca | ibkr   (paper is the only mode that needs no keys)
SANKOFA_BROKER=paper
# Live trading is refused unless this is exactly "yes". Paper mode ignores it.
SANKOFA_LIVE_TRADING_ACK=no

# Alpaca (US-listed ETFs/ADRs; has a free paper-trading endpoint)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

# Interactive Brokers (futures). Requires TWS or IB Gateway running locally.
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=7

# --- Signals ---------------------------------------------------------------
# X / Twitter API v2 bearer token (optional; the recent-search endpoint is on a PAID tier -
# verify current pricing at developer.x.com before relying on it)
X_BEARER_TOKEN=

# --- Alerts ----------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
