# Copy to .env and fill in. NEVER commit .env.
SANKOFA_CONFIG=config/settings.yaml

# --- Execution -------------------------------------------------------------
# paper | ibkr   (paper is the only mode that needs no keys)
SANKOFA_BROKER=paper
# Live trading is refused unless this is exactly "yes". Paper mode ignores it.
SANKOFA_LIVE_TRADING_ACK=no

# Interactive Brokers (futures). Requires TWS or IB Gateway running locally.
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=7

# --- Signals ---------------------------------------------------------------
# Reddit (optional, only for sentiment.reddit.mode: praw). Create a "script" app at
# https://www.reddit.com/prefs/apps - free for personal use at the time of writing; verify.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=sankofa-bot/0.1 by u/your_username

# --- Alerts ----------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
